{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "*.mjs"
  ],
  "exclude": [
    "dist",
    "app",
    "lib",
    "mdx-components.tsx",
    "next.config.ts",
    "next-env.d.ts"
  ]
}