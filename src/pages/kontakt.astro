---
import BaseLayout from "../layouts/BaseLayout.astro";
import { calendlyUrl } from "../lib/site";
---

<BaseLayout
  title="Kontakt | CodeGarden"
  description="Erstgespräch mit CodeGarden vereinbaren: 30 Minuten, kostenlose Ersteinschätzung Ihres Projekts, kein Verkaufs-Pitch."
  canonical="/kontakt"
>
  <main class="flex flex-1 flex-col bg-ink-soft px-6 py-24 text-bone sm:px-12 lg:px-24">
    <div class="mx-auto flex w-full max-w-4xl flex-col items-center text-center">
      <p class="font-sans text-lg uppercase tracking-[0.2em] text-brass">
        Kontakt
      </p>
      <h1
        class="mt-6 font-heading font-medium text-4xl leading-tight tracking-tight text-bone sm:text-5xl"
      >
        Kostenloses Erstgespräch
      </h1>
      <p class="mt-4 max-w-2xl font-sans text-lg text-bone/70">
        Kostenlose und unverbindliche Ersteinschätzung Ihres Produkts in 30 Minuten. Wählen Sie
        direkt einen passenden Termin.
      </p>
    </div>

    <div
      class="calendly-inline-widget mx-auto mt-12 w-full max-w-4xl rounded-sm"
      data-url={calendlyUrl}
      style="min-width:320px;height:950px;"
    >
    </div>
  </main>
</BaseLayout>
