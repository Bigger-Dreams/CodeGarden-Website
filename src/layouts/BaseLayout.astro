---
import "../styles/fonts.css";
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import SiteJsonLd from "../components/SiteJsonLd.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  type?: "website" | "article";
  noindex?: boolean;
};

const { title, description, canonical, ogImage, ogImageAlt, type, noindex } =
  Astro.props;
---

<html lang="de" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1a1a1a" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Nur Verbindung vorwärmen, Skript wird erst geladen, wenn die
    Kontakt-Section mit dem Inline-Widget in die Nähe des Viewports scrollt
    (src/scripts/calendly.ts) — erspart allen anderen Besuchen das
    Calendly-Cookie komplett. -->
    <link rel="preconnect" href="https://assets.calendly.com" />
    <link rel="preconnect" href="https://calendly.com" />
    <link rel="dns-prefetch" href="https://assets.calendly.com" />
    <link rel="dns-prefetch" href="https://calendly.com" />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      type={type}
      noindex={noindex}
    />
  </head>
  <body class="min-h-full flex flex-col">
    <SiteJsonLd />
    <script is:inline>
      if ("scrollRestoration" in window.history) {
        window.history.scrollRestoration = "manual";
        window.scrollTo({ top: 0, left: 0, behavior: "instant" });
      }
    </script>

    <Nav />

    <slot />

    <Footer />

    <script>
      import { initPostHog, posthog } from "../lib/posthog";
      if (initPostHog()) posthog.capture("$pageview");
    </script>
    <script>
      import "../scripts/calendly";
    </script>
  </body>
</html>
