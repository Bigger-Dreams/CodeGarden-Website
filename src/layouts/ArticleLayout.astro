---
import BaseLayout from "./BaseLayout.astro";
import ArticleJsonLd from "../components/ArticleJsonLd.astro";
import { formatArticleDate } from "../lib/blog";

type Props = {
  title: string;
  description: string;
  slug: string;
  publishedTime: string;
  modifiedTime?: string;
};

const { title, description, slug, publishedTime, modifiedTime } =
  Astro.props;
---

<BaseLayout
  title={`${title} | CodeGarden`}
  description={description}
  canonical={`/blog/${slug}`}
>
  <main class="flex flex-1 flex-col bg-ink-soft px-6 py-24 text-bone sm:px-12 lg:px-24">
    <div class="mx-auto flex w-full max-w-3xl flex-col">
      <ArticleJsonLd
        title={title}
        description={description}
        slug={slug}
        publishedTime={publishedTime}
        modifiedTime={modifiedTime}
      />
      <p class="mb-8 font-sans text-sm text-bone/50">
        Veröffentlicht am {formatArticleDate(publishedTime)} · Patrick Roith
      </p>
      <slot />
    </div>
  </main>
</BaseLayout>
