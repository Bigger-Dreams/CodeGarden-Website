---
const services = [
  {
    title: "Beratung & Konzeption",
    text: "In der kostenlosen Erstberatung werden alle Anforderungen eingeholt, gemeinsam priorisiert und der Umfang des Projekts abgesteckt. Daraufhin wird ein passendes Konzept für Sie erstellt, das alle Anforderungen abdeckt.",
    icon: "chat",
  },
  {
    title: "UI/UX-Modernisierung",
    text: "Wir arbeiten ausschließlich mit modernen Designs, die eine verbesserte User Experience und ein modernes User Interface auf Desktop und Mobile garantieren.",
    icon: "interface",
  },
  {
    title: "Frontend-Neuentwicklung",
    text: "Die Entwicklung des Frontend wird mit Next.js und React umgesetzt. Die Schnittstelle zum Backend an Ihre bestehenden Systeme ist eine klare Anforderung, die vorausgesetzt ist.",
    icon: "code",
  },
] as const;
---

<section id="leistungen" class="bg-ink px-6 py-24 text-bone sm:px-12 lg:px-24">
  <div class="mx-auto flex w-full max-w-6xl flex-col">
    <p class="font-sans text-lg uppercase tracking-[0.2em] text-brass">
      Unsere Leistungen im Überblick
    </p>
    <h2
      class="mt-6 max-w-xl font-heading font-medium text-3xl leading-tight tracking-tight text-bone sm:text-4xl"
    >
      Konzept, Design und Umsetzung einfach aus einer Hand.
    </h2>

    <div class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-3">
      {
        services.map((service) => (
          <div class="rounded-sm bg-bone/[0.06] p-8">
            {service.icon === "chat" && (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                class="h-7 w-7 text-brass"
                aria-hidden="true"
              >
                <path
                  d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v9a1.5 1.5 0 0 1-1.5 1.5H9l-4 3.5v-3.5H5.5A1.5 1.5 0 0 1 4 14.5v-9Z"
                  stroke-linejoin="round"
                />
              </svg>
            )}
            {service.icon === "interface" && (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                class="h-7 w-7 text-brass"
                aria-hidden="true"
              >
                <rect x="3" y="4.5" width="18" height="12" rx="1.5" />
                <path d="M8 20h8M12 16.5v3.5" stroke-linecap="round" />
              </svg>
            )}
            {service.icon === "code" && (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                class="h-7 w-7 text-brass"
                aria-hidden="true"
              >
                <path
                  d="M9 8l-4 4 4 4M15 8l4 4-4 4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            )}
            <h3 class="mt-5 font-heading font-medium text-2xl text-bone">
              {service.title}
            </h3>
            <p class="mt-3 font-sans text-base leading-relaxed text-bone/70">
              {service.text}
            </p>
          </div>
        ))
      }
    </div>

    <p class="mt-16 font-sans text-sm text-bone/50">
      Die Preise sind pro Projektumfang unterschiedlich und werden nach dem ersten Beratungsgespräch übermittelt.
    </p>
  </div>
</section>
