---
type Props = { class?: string };
const { class: className } = Astro.props;
---

<div
  class={`relative rounded-[45px] bg-[#0a0a0a] p-3 shadow-2xl shadow-black/40 ${className ?? ""}`}
>
  <div class="relative overflow-hidden rounded-[33px]">
    <slot />
    <div
      class="absolute left-1/2 top-2 h-[22px] w-[92px] -translate-x-1/2 rounded-full bg-[#0a0a0a]"
    >
    </div>
  </div>
</div>
