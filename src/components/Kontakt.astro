---
import { calendlyUrl } from "../lib/site";
---

<section id="kontakt" class="bg-ink-soft px-6 py-24 text-bone sm:px-12 lg:px-24">
  <div
    class="mx-auto flex w-full max-w-6xl flex-col rounded-sm bg-bone/[0.06] px-4 py-12 sm:px-10 lg:px-16"
  >
    <div class="mx-auto max-w-2xl text-center">
      <p class="font-sans text-lg uppercase tracking-[0.2em] text-brass">
        Kontakt
      </p>
      <h2
        class="mt-6 font-heading font-medium text-3xl leading-tight tracking-tight text-bone sm:text-4xl"
      >
        Sie sind an einer Zusammenarbeit interessiert?
      </h2>
      <p class="mt-4 font-sans text-lg text-bone/70">
        Buchen Sie direkt einen kurzen Termin für eine erste Einschätzung Ihres Projekts.
      </p>
      <a
        href={calendlyUrl}
        data-calendly-trigger
        data-calendly-location="kontakt"
        class="mt-10 inline-flex items-center justify-center rounded-sm bg-brass px-6 py-3 font-sans text-sm font-medium text-ink transition-colors hover:bg-brass-bright"
      >
        Erstgespräch vereinbaren
      </a>
    </div>
  </div>
</section>
