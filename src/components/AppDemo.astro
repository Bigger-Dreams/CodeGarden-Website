---
type Props = { class?: string };
const { class: className } = Astro.props;

const accounts = [
  { label: "Gehaltskonto", value: "€ 4.823,10" },
  { label: "Sparkonto", value: "€ 6.450,00" },
  { label: "Verrechnungskonto", value: "€ 2.047,55" },
];

const transactions = [
  { title: "Kauf Andritz AG", subtitle: "Depot · Handel", amount: "−€ 1.050,60", positive: false },
  { title: "Gehalt", subtitle: "Employer GmbH · Einkommen", amount: "+€ 3.200,00", positive: true },
  {
    title: "Verkauf AT&S Austria Tech. & Systemtech.",
    subtitle: "Depot · Handel",
    amount: "+€ 434,00",
    positive: true,
  },
];
---

<div
  class={`relative flex aspect-[1206/2622] flex-col overflow-hidden bg-[#0e0e10] ${className ?? ""}`}
>
  <div class="flex items-center justify-between px-5 pt-3">
    <span class="font-sans text-[13px] font-medium text-white">9:41</span>
    <div class="flex items-center gap-1 text-white/70">
      <svg width="16" height="11" viewBox="0 0 16 11" fill="currentColor">
        <rect x="0" y="7" width="3" height="4" rx="0.5"></rect>
        <rect x="4.5" y="5" width="3" height="6" rx="0.5"></rect>
        <rect x="9" y="3" width="3" height="8" rx="0.5"></rect>
        <rect x="13" y="0" width="3" height="11" rx="0.5"></rect>
      </svg>
      <svg width="15" height="11" viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.4">
        <path d="M1 4.5C4.8 1 11.2 1 15 4.5" stroke-linecap="round"></path>
        <path d="M3.5 7.2C5.9 5 10.1 5 12.5 7.2" stroke-linecap="round"></path>
        <path d="M6.3 9.8C7.2 9 8.8 9 9.7 9.8" stroke-linecap="round"></path>
      </svg>
      <svg width="24" height="12" viewBox="0 0 24 12" fill="none">
        <rect x="0.5" y="0.5" width="20" height="11" rx="2.5" stroke="currentColor"></rect>
        <rect x="2" y="2" width="17" height="8" rx="1.5" fill="currentColor"></rect>
        <rect x="21.5" y="4" width="1.5" height="4" rx="0.75" fill="currentColor"></rect>
      </svg>
    </div>
  </div>

  <h1 class="mt-2 text-center font-sans text-[15px] font-semibold text-white">
    Übersicht
  </h1>

  <div class="flex-1 overflow-hidden pb-16">
    <div class="mt-5 px-5">
      <p class="font-sans text-[11px] text-white/45">Guten Tag,</p>
      <p class="mt-0.5 font-sans text-lg font-bold text-white">Patrick</p>
    </div>

    <div class="mt-4 px-5">
      <p class="font-sans text-[11px] text-white/45">Gesamtvermögen</p>
      <p class="mt-0.5 font-sans text-[26px] font-bold text-white">€ 17.205,71</p>
    </div>

    <div class="mt-4 flex gap-2 px-5">
      {
        accounts.map((account) => (
          <div class="flex-1 rounded-xl border border-white/10 bg-white/[0.04] px-2.5 py-2">
            <p class="truncate font-sans text-[9px] text-white/45">{account.label}</p>
            <p class="mt-0.5 truncate font-sans text-[11px] font-medium text-white">
              {account.value}
            </p>
          </div>
        ))
      }
    </div>

    <div class="mx-5 mt-4 rounded-2xl border border-white/10 bg-white/[0.04] p-4">
      <p class="font-sans text-[11px] text-white/45">Vermögensentwicklung</p>
      <div class="mt-1 flex items-center gap-2">
        <p class="font-sans text-xl font-bold text-white">€ 17.205,71</p>
        <span class="rounded-full bg-rose-500/15 px-2 py-0.5 font-sans text-[10px] font-medium text-rose-400">
          −0,90%
        </span>
      </div>
      <p class="mt-0.5 font-sans text-[11px] text-white/45">−€ 155,98 heute</p>

      <svg viewBox="0 0 300 90" class="mt-3 w-full" preserveAspectRatio="none">
        <defs>
          <linearGradient id="chart-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#ec4899" stop-opacity="0.35"></stop>
            <stop offset="100%" stop-color="#ec4899" stop-opacity="0"></stop>
          </linearGradient>
        </defs>
        <path
          d="M0,70 C30,40 55,85 80,65 C110,42 140,20 170,35 C200,50 220,68 250,45 C270,30 285,15 300,10 L300,90 L0,90 Z"
          fill="url(#chart-fill)"
        ></path>
        <path
          d="M0,70 C30,40 55,85 80,65 C110,42 140,20 170,35 C200,50 220,68 250,45 C270,30 285,15 300,10"
          fill="none"
          stroke="#ec4899"
          stroke-width="2.5"
          stroke-linecap="round"
        ></path>
      </svg>
    </div>

    <div class="mt-4 flex justify-around px-5">
      <div class="flex flex-col items-center gap-1.5">
        <div class="flex h-11 w-11 items-center justify-center rounded-full bg-white/[0.06] text-white/80">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 8h13l-3.5-3.5" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M18 16H5l3.5 3.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
        <p class="font-sans text-[10px] text-white/70">Überweisen</p>
      </div>
      <div class="flex flex-col items-center gap-1.5">
        <div class="flex h-11 w-11 items-center justify-center rounded-full bg-white/[0.06] text-white/80">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 16l5-5 4 4 7-7" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M15 8h5v5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
        <p class="font-sans text-[10px] text-white/70">Order aufgeben</p>
      </div>
      <div class="flex flex-col items-center gap-1.5">
        <div class="flex h-11 w-11 items-center justify-center rounded-full bg-white/[0.06] text-white/80">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path
              d="M4 12c0-3.3 3.1-6 7-6 3 0 5.6 1.6 6.6 3.9L20 10v3l-2 .5c-.3 1-.9 1.9-1.7 2.5V18h-2.6v-1.2A8 8 0 0 1 11 17c-3.9 0-7-2.7-7-6Z"
              stroke-linejoin="round"
            ></path>
            <circle cx="8.5" cy="11" r="0.8" fill="currentColor" stroke="none"></circle>
          </svg>
        </div>
        <p class="font-sans text-[10px] text-white/70">Sparziel</p>
      </div>
    </div>

    <div class="mx-5 mt-4 rounded-2xl border border-white/10 bg-white/[0.04] p-4">
      <p class="font-sans text-[13px] font-semibold text-white">Letzte Aktivität</p>
      <div class="mt-3 flex flex-col">
        {
          transactions.map((tx, index) => (
            <div
              class={`flex items-start justify-between gap-3 py-2.5 ${
                index > 0 ? "border-t border-white/10" : ""
              }`}
            >
              <div class="min-w-0">
                <p class="truncate font-sans text-[12px] font-medium text-white">
                  {tx.title}
                </p>
                <p class="truncate font-sans text-[10px] text-white/45">{tx.subtitle}</p>
              </div>
              <p
                class={`shrink-0 font-sans text-[12px] font-medium ${
                  tx.positive ? "text-emerald-400" : "text-white"
                }`}
              >
                {tx.amount}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="absolute inset-x-0 bottom-0 flex items-center justify-around border-t border-white/10 bg-[#0e0e10] px-2 py-2.5">
    <div class="flex flex-col items-center gap-1">
      <div class="text-pink-400">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <rect x="3" y="3" width="8" height="8" rx="2"></rect>
          <rect x="13" y="3" width="8" height="8" rx="2"></rect>
          <rect x="3" y="13" width="8" height="8" rx="2"></rect>
          <rect x="13" y="13" width="8" height="8" rx="2"></rect>
        </svg>
      </div>
      <p class="font-sans text-[8.5px] text-pink-400">Übersicht</p>
    </div>
    <div class="flex flex-col items-center gap-1">
      <div class="text-white/40">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="6" width="18" height="13" rx="2"></rect>
          <path d="M3 10h18"></path>
          <circle cx="16" cy="14" r="1" fill="currentColor" stroke="none"></circle>
        </svg>
      </div>
      <p class="font-sans text-[8.5px] text-white/40">Konto</p>
    </div>
    <div class="flex flex-col items-center gap-1">
      <div class="text-white/40">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 16l5-5 4 4 7-7" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M15 8h5v5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
      <p class="font-sans text-[8.5px] text-white/40">Depot</p>
    </div>
    <div class="flex flex-col items-center gap-1">
      <div class="text-white/40">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 20V10M12 20V4M20 20v-7" stroke-linecap="round"></path>
        </svg>
      </div>
      <p class="font-sans text-[8.5px] text-white/40">Märkte</p>
    </div>
    <div class="flex flex-col items-center gap-1">
      <div class="text-white/40">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="8" r="3.5"></circle>
          <path d="M5 20c1.5-4 4.5-6 7-6s5.5 2 7 6" stroke-linecap="round"></path>
        </svg>
      </div>
      <p class="font-sans text-[8.5px] text-white/40">Profile</p>
    </div>
  </div>
</div>
