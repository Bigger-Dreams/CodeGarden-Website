---
const projects = [
  {
    label: "Banking WebApp",
    src: "/referenz-mockup-1.webp",
    alt: "Laptop-Mockup der Finanz-App-Übersicht: Gesamtvermögen mit Konten-Kacheln und Schnellaktionen (Konzeptprojekt, kein Kundenauftrag)",
    caption:
      "Modernes User Interface mit optimierter User Experience für Bank Kunden, um die wichtigsten Informationen auf einen Blick zu erhalten.",
  },
  {
    label: "Banking Mobile App",
    src: "/referenz-banking-app.svg",
    alt: "Smartphone-Mockup der Finanz-App-Übersicht: Gesamtvermögen, Chart, Konten und Schnellaktionen (Konzeptprojekt, kein Kundenauftrag)",
    caption:
      "Übersichtliches Mobile-Design mit den wichtigsten Funktionen auf einen Blick.",
  },
];
---

<section id="referenzen" class="bg-ink-soft px-6 py-24 text-bone sm:px-12 lg:px-24">
  <div class="mx-auto flex w-full max-w-6xl flex-col">
    <p class="font-sans text-lg uppercase tracking-[0.2em] text-brass">
      Referenzprojekte
    </p>
    <h2 class="mt-6 font-heading font-medium text-3xl leading-tight tracking-tight text-bone sm:text-4xl">
      So könnte Ihr Produkt aussehen.
    </h2>
    <p class="font-sans text-lg text-bone/70">
      Bei allen Projekten ist ein modernes User
      Interface und eine optimierte User Experience das Ziel.
    </p>
  </div>

  <div class="relative mx-auto mt-16 w-full max-w-6xl">
    <div
      id="referenzen-scroller"
      class="flex snap-x snap-mandatory overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      {
        projects.map((project, index) => (
          <div class="flex w-full flex-shrink-0 snap-start">
            <div class="grid h-full w-full grid-cols-1 rounded-sm border border-bone/10 lg:min-h-[440px] lg:grid-cols-[2fr_3fr]">
              <div class="flex min-h-[330px] flex-col justify-center gap-4 p-8 sm:min-h-[360px] sm:p-12 lg:min-h-0">
                <span class="w-fit rounded-sm bg-brass px-2 py-1 font-sans text-[10px] font-medium uppercase tracking-widest text-ink">
                  Prototype
                </span>
                <h3 class="font-heading font-medium text-2xl text-bone sm:text-3xl">
                  {project.label}
                </h3>
                <p class="font-sans text-base leading-relaxed text-bone/70">
                  {project.caption}
                </p>
              </div>
              <div class="relative aspect-[3/2] w-full p-4 sm:p-6 lg:aspect-auto lg:h-full lg:min-h-[320px]">
                <div class="relative h-full w-full overflow-hidden rounded-sm">
                  <img
                    src={project.src}
                    alt={project.alt}
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : undefined}
                    class="absolute inset-0 h-full w-full object-cover"
                  />
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <button
      type="button"
      id="referenzen-prev"
      aria-label="Vorheriges Projekt"
      class="absolute left-3 top-[38%] flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-bone/15 bg-ink-soft/90 text-bone transition-colors hover:bg-bone/10 disabled:pointer-events-none disabled:opacity-0"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        class="h-4 w-4 rotate-180"
        aria-hidden="true"
      >
        <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <button
      type="button"
      id="referenzen-next"
      aria-label="Nächstes Projekt"
      class="absolute right-3 top-[38%] flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-bone/15 bg-ink-soft/90 text-bone transition-colors hover:bg-bone/10 disabled:pointer-events-none disabled:opacity-0"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        class="h-4 w-4"
        aria-hidden="true"
      >
        <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <div id="referenzen-dots" class="mt-6 flex items-center justify-center gap-3">
      {
        projects.map((project, index) => (
          <button
            type="button"
            data-index={index}
            aria-label={`${project.label} anzeigen`}
            aria-current={index === 0}
            class={`h-2 w-2 rounded-full transition-colors ${
              index === 0 ? "bg-brass" : "bg-bone/25 hover:bg-bone/40"
            }`}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  const scroller = document.getElementById("referenzen-scroller");
  const prevButton = document.getElementById(
    "referenzen-prev",
  ) as HTMLButtonElement | null;
  const nextButton = document.getElementById(
    "referenzen-next",
  ) as HTMLButtonElement | null;
  const dotsContainer = document.getElementById("referenzen-dots");

  if (scroller && prevButton && nextButton && dotsContainer) {
    const slides = Array.from(scroller.children) as HTMLElement[];
    const dots = Array.from(dotsContainer.children) as HTMLButtonElement[];

    const goTo = (index: number) => {
      slides[index]?.scrollIntoView({
        behavior: "smooth",
        inline: "start",
        block: "nearest",
      });
    };

    const update = (active: number) => {
      prevButton.disabled = active === 0;
      nextButton.disabled = active === slides.length - 1;
      dots.forEach((dot, index) => {
        const isActive = index === active;
        dot.setAttribute("aria-current", String(isActive));
        dot.classList.toggle("bg-brass", isActive);
        dot.classList.toggle("bg-bone/25", !isActive);
        dot.classList.toggle("hover:bg-bone/40", !isActive);
      });
    };

    let active = 0;
    update(active);

    scroller.addEventListener("scroll", () => {
      const index = Math.round(scroller.scrollLeft / scroller.clientWidth);
      active = Math.min(slides.length - 1, Math.max(0, index));
      update(active);
    });

    prevButton.addEventListener("click", () => goTo(active - 1));
    nextButton.addEventListener("click", () => goTo(active + 1));
    dots.forEach((dot, index) => dot.addEventListener("click", () => goTo(index)));
  }
</script>
