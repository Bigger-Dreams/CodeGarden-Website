# Copy to .env.local for local development, and set the same values as
# Build variables in the Cloudflare Workers project settings for production
# (these are baked in at build time, not read at runtime).

# Canonical base URL of the production site. Used to build absolute URLs in
# metadata, OpenGraph images, sitemap-index.xml and robots.txt. See
# src/lib/site.ts.
PUBLIC_SITE_URL=https://codegarden.at

# PostHog project API key (Project Settings -> Project API Key in PostHog).
# Leave unset to keep analytics fully disabled — no banner, no tracking.
# Requests are routed through /ingest (see worker/index.js's proxy) to
# PostHog's EU cloud, so there's no separate host variable to set here.
# PUBLIC_-Präfix ist hier Pflicht: nur so macht Astro/Vite den Wert im
# Browser-Script verfügbar (import.meta.env), siehe src/lib/posthog.ts.
PUBLIC_POSTHOG_KEY=
