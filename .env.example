# Copy to .env.local for local development, and set the same values in the
# Vercel project's environment variables for production.

# Canonical base URL of the production site. Used to build absolute URLs in
# metadata, OpenGraph images, sitemap.xml and robots.txt. See lib/site.ts.
NEXT_PUBLIC_SITE_URL=https://codegarden.at

# PostHog project API key (Project Settings -> Project API Key in PostHog).
# Leave unset to keep analytics fully disabled — no banner, no tracking.
# Requests are routed through /ingest (see next.config.ts's rewrites) to
# PostHog's EU cloud, so there's no separate host variable to set here.
NEXT_PUBLIC_POSTHOG_KEY=
