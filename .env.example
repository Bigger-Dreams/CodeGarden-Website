# Copy to .env.local for local development, and set the same values in the
# Vercel project's environment variables for production.

# Base URL of the production site. Used to build absolute URLs in
# sitemap.xml and robots.txt. See lib/site.ts.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# PostHog project API key (Project Settings -> Project API Key in PostHog).
# Leave unset to keep analytics fully disabled — no banner, no tracking.
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog ingestion host. Defaults to the EU cloud if left unset, which is
# the right choice for a Wien/Österreich-facing site. Only override this if
# using a different PostHog region or a self-hosted instance.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
